# Optional local defaults. Copy this file to `.env` and export the values
# in your shell, or pass the same paths as CLI flags.
#
#   export X4CATALOG_SOURCE="$HOME/Pictures/x4-library"
#   export X4CATALOG_ROOT="$HOME/x4-catalog-data"
#
# `.env` itself is gitignored. Do not put secrets in git.

# Read-only folder of 480x800 BMP sleep screens
# X4CATALOG_SOURCE=/absolute/path/to/your/bmp-library

# Working directory for SQLite, thumbnails, models, views, and exports
# X4CATALOG_ROOT=/absolute/path/to/catalog-data

# Override only if you keep the web UI somewhere other than ./static
# X4CATALOG_STATIC=/absolute/path/to/static

# Hosted snapshot (DigitalOcean Spaces). Never commit the secret.
# Create the key under Control Panel → Spaces Object Storage → Access Keys,
# not inside the Space itself. The secret is shown only at creation.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_BUCKET=x4catalog
# PUBLIC_BASE=https://x4catalog.nyc3.cdn.digitaloceanspaces.com
